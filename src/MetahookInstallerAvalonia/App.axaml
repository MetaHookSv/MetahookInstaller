<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u-semi="https://irihi.tech/ursa/themes/semi"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:icons="https://github.com/projektanker/icons.avalonia"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="MetahookInstallerAvalonia.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 令牌对齐 Fluent 2（WinUI 3）调色板：分层填充 + 细描边，阴影保持极弱。 -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BackgroundColor">#00000000</Color>
                    <Color x:Key="BackgroundAcrylicColor">#11F9F9F9</Color>
                    <!-- 控件/卡片填充（ControlFillColorDefault、CardBackgroundFillColorDefault） -->
                    <Color x:Key="SurfaceColor">#B3FFFFFF</Color>
                    <!-- 次要填充（SubtleFillColorSecondary）；用于列表头、徽章、预览底 -->
                    <Color x:Key="SurfaceLightColor">#0F000000</Color>
                    <Color x:Key="SurfaceAcrylicColor">#CCFFFFFF</Color>
                    <!-- 强调色（AccentFillColorDefault） -->
                    <Color x:Key="PrimaryColor">#0078D4</Color>
                    <Color x:Key="PrimaryLightColor">#260078D4</Color>
                    <Color x:Key="PrimaryLightHoverColor">#3D0078D4</Color>
                    <!-- 文本（TextFillColorPrimary / Secondary） -->
                    <Color x:Key="TextPrimaryColor">#E4000000</Color>
                    <Color x:Key="TextSecondaryColor">#9E000000</Color>
                    <!-- 描边（CardStrokeColorDefault / ControlStrokeColorDefault） -->
                    <Color x:Key="BorderColor">#0F000000</Color>
                    <Color x:Key="BorderLightColor">#1A000000</Color>
                    <!-- 悬停/按下填充（SubtleFillColorSecondary / Tertiary） -->
                    <Color x:Key="SubtleFillHoverColor">#0A000000</Color>
                    <Color x:Key="SubtleFillPressedColor">#15000000</Color>
                    <Color x:Key="WindowBackgroundColor">#CCF9F9F9</Color>
                    <Color x:Key="TitleBarBackgroundColor">#99F9F9F9</Color>
                    <Color x:Key="ContentBackgroundColor">#B3F9F9F9</Color>
                    <Color x:Key="TitleBarButtonBackgroundColor">#00000000</Color>
                    <Color x:Key="TitleBarCloseHoverColor">#C42B1C</Color>
                    <Color x:Key="TitleBarForegroundColor">#E4000000</Color>
                    <!-- Ursa 的 IconButton 把悬停/按下底色画在模板内 Border#PART_Background 上并消费
                         这两个 Semi 键，在此重定向到 Fluent 细填充令牌，统一全部默认按钮的交互态。 -->
                    <SolidColorBrush x:Key="ButtonDefaultPointeroverBackground" Color="{DynamicResource SubtleFillHoverColor}" />
                    <SolidColorBrush x:Key="ButtonDefaultPressedBackground" Color="{DynamicResource SubtleFillPressedColor}" />
                    <!-- 派生资源 -->
                    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
                    <SolidColorBrush x:Key="BackgroundAcrylicBrush" Color="{DynamicResource BackgroundAcrylicColor}" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
                    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{DynamicResource SurfaceLightColor}" />
                    <SolidColorBrush x:Key="SurfaceAcrylicBrush" Color="{DynamicResource SurfaceAcrylicColor}" />
                    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
                    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}" />
                    <SolidColorBrush x:Key="PrimaryLightHoverBrush" Color="{DynamicResource PrimaryLightHoverColor}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
                    <SolidColorBrush x:Key="BorderLightBrush" Color="{DynamicResource BorderLightColor}" />
                    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="{DynamicResource SubtleFillHoverColor}" />
                    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="{DynamicResource SubtleFillPressedColor}" />
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{DynamicResource TitleBarBackgroundColor}" />
                    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{DynamicResource ContentBackgroundColor}" />
                    <SolidColorBrush x:Key="TitleBarButtonBackgroundBrush" Color="{DynamicResource TitleBarButtonBackgroundColor}" />
                    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="{DynamicResource TitleBarCloseHoverColor}" />
                    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="{DynamicResource TitleBarForegroundColor}" />
                    <!-- 卡片与窗口阴影：保持极弱，仅作层级提示 -->
                    <BoxShadows x:Key="CardShadow">0 1 2 0 #0F000000</BoxShadows>
                    <BoxShadows x:Key="WindowShadow">0 8 24 4 #26000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BackgroundColor">#00000000</Color>
                    <Color x:Key="BackgroundAcrylicColor">#11FFFFFF</Color>
                    <Color x:Key="SurfaceColor">#0DFFFFFF</Color>
                    <Color x:Key="SurfaceLightColor">#0FFFFFFF</Color>
                    <Color x:Key="SurfaceAcrylicColor">#19FFFFFF</Color>
                    <Color x:Key="PrimaryColor">#60CDFF</Color>
                    <Color x:Key="PrimaryLightColor">#2660CDFF</Color>
                    <Color x:Key="PrimaryLightHoverColor">#3D60CDFF</Color>
                    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
                    <Color x:Key="TextSecondaryColor">#C5FFFFFF</Color>
                    <Color x:Key="BorderColor">#19000000</Color>
                    <Color x:Key="BorderLightColor">#15FFFFFF</Color>
                    <Color x:Key="SubtleFillHoverColor">#0FFFFFFF</Color>
                    <Color x:Key="SubtleFillPressedColor">#1AFFFFFF</Color>
                    <Color x:Key="WindowBackgroundColor">#CC202020</Color>
                    <Color x:Key="TitleBarBackgroundColor">#99202020</Color>
                    <Color x:Key="ContentBackgroundColor">#B3282828</Color>
                    <Color x:Key="TitleBarButtonBackgroundColor">#00000000</Color>
                    <Color x:Key="TitleBarCloseHoverColor">#C42B1C</Color>
                    <Color x:Key="TitleBarForegroundColor">#FFFFFFFF</Color>
                    <!-- 与浅色字典同理：重定向 Ursa IconButton 模板消费的悬停/按下键。 -->
                    <SolidColorBrush x:Key="ButtonDefaultPointeroverBackground" Color="{DynamicResource SubtleFillHoverColor}" />
                    <SolidColorBrush x:Key="ButtonDefaultPressedBackground" Color="{DynamicResource SubtleFillPressedColor}" />
                    <!-- 派生资源 -->
                    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
                    <SolidColorBrush x:Key="BackgroundAcrylicBrush" Color="{DynamicResource BackgroundAcrylicColor}" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
                    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{DynamicResource SurfaceLightColor}" />
                    <SolidColorBrush x:Key="SurfaceAcrylicBrush" Color="{DynamicResource SurfaceAcrylicColor}" />
                    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
                    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}" />
                    <SolidColorBrush x:Key="PrimaryLightHoverBrush" Color="{DynamicResource PrimaryLightHoverColor}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
                    <SolidColorBrush x:Key="BorderLightBrush" Color="{DynamicResource BorderLightColor}" />
                    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="{DynamicResource SubtleFillHoverColor}" />
                    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="{DynamicResource SubtleFillPressedColor}" />
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
                    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{DynamicResource TitleBarBackgroundColor}" />
                    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{DynamicResource ContentBackgroundColor}" />
                    <SolidColorBrush x:Key="TitleBarButtonBackgroundBrush" Color="{DynamicResource TitleBarButtonBackgroundColor}" />
                    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="{DynamicResource TitleBarCloseHoverColor}" />
                    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="{DynamicResource TitleBarForegroundColor}" />
                    <BoxShadows x:Key="CardShadow">0 1 2 0 #33000000</BoxShadows>
                    <BoxShadows x:Key="WindowShadow">0 8 24 4 #59000000</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <semi:SemiTheme />
        <semi:UrsaSemiTheme/>
        <!-- Lets Ursa IconButton take icon names (e.g. "mdi-close") served by Optris.Icons.Avalonia. -->
        <Style Selector="u|IconButton">
            <Setter Property="IconTemplate">
                <DataTemplate DataType="{x:Type sys:String}">
                    <icons:Icon Value="{Binding}" />
                </DataTemplate>
            </Setter>
        </Style>
        <!-- 悬停/按下底色画在模板 Border 上，过渡也必须挂在同一元素上才生效。 -->
        <Style Selector="u|IconButton /template/ Border#PART_Background">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
