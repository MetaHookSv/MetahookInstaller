<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:u="https://irihi.tech/ursa"
xmlns:icons="https://github.com/projektanker/icons.avalonia"
xmlns:vm="clr-namespace:MetahookInstallerAvalonia.ViewModels"
xmlns:lang="clr-namespace:MetahookInstallerAvalonia.Lang"
mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
x:Class="MetahookInstallerAvalonia.Views.EditorPage"
x:DataType="vm:MainViewModel">
<Design.DataContext>
  <vm:MainViewModel />
</Design.DataContext>
<Grid Margin="16" RowDefinitions="*,Auto" RowSpacing="12">
  <!-- 核心布局：左右列表 + 中间按钮 -->
  <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
    <!-- 左侧已启用插件列表 -->
    <Border Grid.Column="0"
    Background="{DynamicResource SurfaceBrush}"
    CornerRadius="8"
    BorderBrush="{DynamicResource BorderBrush}"
    BorderThickness="1"
    Effect="{DynamicResource SmallShadow}">
    <DockPanel>
      <Label DockPanel.Dock="Top" Classes="list-header"
      Content="{x:Static lang:Resources.EnabledPlugins}"/>
      <ListBox x:Name="PluginListBox"
      Margin="0"
      Padding="4"
      BorderThickness="0"
      Background="Transparent"
      ItemsSource="{CompiledBinding Plugins}"
      SelectedItem="{CompiledBinding SelectedPlugin}"
      SelectionMode="Single"
      Classes="ItemsDragAndDrop">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:PluginInfo">
          <DockPanel VerticalAlignment="Center">
            <icons:Icon Classes="PluginDragHandle" FontSize="10" Value="mdi-drag-vertical"
            Margin="0 0 4 0" Cursor="Hand"
            HorizontalAlignment="Center"/>
            <Border Margin="0" Padding="4"
            Background="{DynamicResource SurfaceLightBrush}"
            CornerRadius="3">
            <DockPanel VerticalAlignment="Center">
              <Border CornerRadius="9" Width="18" Height="18"
              Background="{DynamicResource PrimaryLightBrush}" Margin="0 0 8 0"
              VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock FontSize="11" TextAlignment="Center" VerticalAlignment="Center"
              Foreground="{DynamicResource TextSecondaryBrush}"
              Text="{CompiledBinding Index}"/>
            </Border>
            <CheckBox
            IsChecked="{CompiledBinding Enabled}"
            Content="{CompiledBinding Name}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            FontSize="13">
            <CheckBox.Styles>
              <Style Selector="CheckBox">
                <Setter Property="Padding" Value="4 0"/>
                <Setter Property="Cursor" Value="Hand"/>
              </Style>
              <Style Selector="CheckBox:checked">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
              </Style>
            </CheckBox.Styles>
          </CheckBox>
        </DockPanel>
      </Border>
    </DockPanel>
  </DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</DockPanel>
</Border>
<!-- 中间操作按钮 -->
<StackPanel Grid.Column="1"
Orientation="Vertical"
Spacing="12"
HorizontalAlignment="Center"
VerticalAlignment="Center">
<u:IconButton Icon="mdi-chevron-right"
Command="{CompiledBinding ToAvaliableCommand}"
Width="34"
Height="34"
CornerRadius="17"
Background="{DynamicResource PrimaryLightBrush}"
Foreground="{DynamicResource PrimaryBrush}"/>
<u:IconButton Icon="mdi-chevron-left"
Command="{CompiledBinding ToPluginsCommand}"
Width="34"
Height="34"
CornerRadius="17"
Background="{DynamicResource PrimaryLightBrush}"
Foreground="{DynamicResource PrimaryBrush}"/>
</StackPanel>
<!-- 右侧可用插件列表 -->
<Border Grid.Column="2"
Background="{DynamicResource SurfaceBrush}"
CornerRadius="8"
BorderBrush="{DynamicResource BorderBrush}"
BorderThickness="1"
Effect="{DynamicResource SmallShadow}">
<DockPanel>
  <Label DockPanel.Dock="Top" Classes="list-header"
  Content="{x:Static lang:Resources.AvailablePlugins}"/>
  <ListBox x:Name="AvaliableListBox"
  Margin="0"
  Padding="4"
  BorderThickness="0"
  Background="Transparent"
  ItemsSource="{CompiledBinding Avaliable}"
  SelectedItem="{CompiledBinding SelectedAvaliable}"
  SelectionMode="Single">
  <ListBox.ItemTemplate>
    <DataTemplate>
      <Border Margin="0"
      Padding="8 6"
      Background="{DynamicResource SurfaceLightBrush}"
      CornerRadius="3"
      Cursor="Hand">
      <Label Content="{CompiledBinding Name}"
      Foreground="{DynamicResource TextSecondaryBrush}"
      FontSize="13"
      Padding="0" VerticalContentAlignment="Center"/>
    </Border>
  </DataTemplate>
</ListBox.ItemTemplate>
<!-- 列表项选中样式 -->
<ListBox.Styles>
  <Style Selector="ListBoxItem:selected /template/ Border">
    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
</ListBox.Styles>
</ListBox>
</DockPanel>
</Border>
</Grid>
<!-- 底部操作按钮 -->
<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
HorizontalAlignment="Right">
<u:IconButton Icon="mdi-refresh"
Content="{x:Static lang:Resources.Reset}"
Command="{CompiledBinding ResetCommand}"
Height="32"/>
<u:IconButton Icon="mdi-content-save"
Content="{x:Static lang:Resources.Save}"
Command="{CompiledBinding SaveCommand}"
Height="32"/>
</StackPanel>
</Grid>
</UserControl>
