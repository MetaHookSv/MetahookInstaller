<Window
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:u="https://irihi.tech/ursa"
xmlns:icons="https://github.com/projektanker/icons.avalonia"
xmlns:vm="clr-namespace:MetahookInstallerAvalonia.ViewModels"
xmlns:views="clr-namespace:MetahookInstallerAvalonia.Views"
xmlns:lang="clr-namespace:MetahookInstallerAvalonia.Lang"
mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="500"
x:Class="MetahookInstallerAvalonia.Views.MainWindow"
x:DataType="vm:MainViewModel"
Icon="/Assets/avalonia-logo.ico"
TransparencyLevelHint="AcrylicBlur"
Background="{DynamicResource WindowBackgroundBrush}"
ExtendClientAreaToDecorationsHint="True"
ExtendClientAreaTitleBarHeightHint="-1"
WindowDecorations="BorderOnly"
CanResize="False"
Width="960" Height="500"
CornerRadius="8">
<Window.Styles>
  <Style Selector="u|IconButton.title-bar-btn">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="{DynamicResource TitleBarButtonBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <!-- Ursa 的 IconButton 把悬停/按下底色画在模板内 Border#PART_Background 上，
       因此这里用 /template/ 选择器覆盖，而不是设置控件自身的 Background。 -->
  <Style Selector="u|IconButton.title-bar-btn.close:pointerover /template/ Border#PART_Background">
    <Setter Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}"/>
  </Style>
  <Style Selector="u|IconButton.title-bar-btn.close:pressed /template/ Border#PART_Background">
    <Setter Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}"/>
  </Style>
  <Style Selector="u|IconButton.title-bar-btn.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="u|IconButton.title-bar-btn.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="u|IconButton.breadcrumb-bar-btn">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Opacity" Value="0.8"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="u|IconButton.breadcrumb-bar-btn:pointerover">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="TextBlock.title-text">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
    <Setter Property="Opacity" Value="0.9"/>
  </Style>
</Window.Styles>
<Window.Resources>
  <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceInclude Source="avares://MetahookInstallerAvalonia/Themes/FlagIcons.axaml" />
    </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
</Window.Resources>
<DockPanel Background="{DynamicResource TitleBarBackgroundBrush}">
  <Grid DockPanel.Dock="Top" Height="44"
  Background="Transparent"
  PointerPressed="TitleBar_PointerPressed"
  ColumnDefinitions="Auto,1*,Auto">
  <Image Grid.Column="0"
  Source="/Assets/avalonia-logo.ico"
  Width="22" Height="22"
  Margin="10,0,8,0"
  VerticalAlignment="Center"
  Opacity="0.9"/>
  <!-- 标题文本 -->
  <TextBlock Grid.Column="1"
  Classes="title-text"
  Text="{x:Static lang:Resources.MainMenuTitle}"
  VerticalAlignment="Center"/>
  <!-- 窗口控制按钮 -->
  <StackPanel Grid.Column="3" Orientation="Horizontal">
    <u:Breadcrumb Height="18"  Margin="0 0 40 0" Padding="8">
      <u:IconButton Classes="breadcrumb-bar-btn" Icon="mdi-github" Click="GithubButton_Click"/>
      <u:IconButton Classes="breadcrumb-bar-btn" Icon="mdi-translate">
        <u:IconButton.Flyout>
          <MenuFlyout>
            <MenuItem Command="{CompiledBinding ChangeLanguageCommand}" CommandParameter="zh-CN">
              <MenuItem.Header>
                <DockPanel>
                  <PathIcon Data="{StaticResource FlagCn}" Margin="0 0 4 0"/>
                  <Label Content="{x:Static lang:Resources.Lang_CN}"/>
                </DockPanel>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem Command="{CompiledBinding ChangeLanguageCommand}" CommandParameter="en-US">
              <MenuItem.Header>
                <DockPanel>
                  <PathIcon Data="{StaticResource FlagUs}" Margin="0 0 4 0"/>
                  <Label Content="{x:Static lang:Resources.Lang_US}"/>
                </DockPanel>
              </MenuItem.Header>
            </MenuItem>
          </MenuFlyout>
        </u:IconButton.Flyout>
      </u:IconButton>
      <u:IconButton Classes="breadcrumb-bar-btn" Icon="mdi-theme-light-dark">
        <u:IconButton.Flyout>
          <MenuFlyout>
            <MenuItem Command="{CompiledBinding ChangeThemeCommand}" CommandParameter="System">
              <MenuItem.Header>
                <Grid ColumnDefinitions="18,*">
                  <icons:Icon Value="mdi-check" FontSize="13" VerticalAlignment="Center"
                  Foreground="{DynamicResource PrimaryBrush}"
                  IsVisible="{CompiledBinding IsSystemTheme}"/>
                  <Label Grid.Column="1" Content="{x:Static lang:Resources.Theme_System}"/>
                </Grid>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem Command="{CompiledBinding ChangeThemeCommand}" CommandParameter="Light">
              <MenuItem.Header>
                <Grid ColumnDefinitions="18,*">
                  <icons:Icon Value="mdi-check" FontSize="13" VerticalAlignment="Center"
                  Foreground="{DynamicResource PrimaryBrush}"
                  IsVisible="{CompiledBinding IsLightTheme}"/>
                  <Label Grid.Column="1" Content="{x:Static lang:Resources.Theme_Light}"/>
                </Grid>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem Command="{CompiledBinding ChangeThemeCommand}" CommandParameter="Dark">
              <MenuItem.Header>
                <Grid ColumnDefinitions="18,*">
                  <icons:Icon Value="mdi-check" FontSize="13" VerticalAlignment="Center"
                  Foreground="{DynamicResource PrimaryBrush}"
                  IsVisible="{CompiledBinding IsDarkTheme}"/>
                  <Label Grid.Column="1" Content="{x:Static lang:Resources.Theme_Dark}"/>
                </Grid>
              </MenuItem.Header>
            </MenuItem>
          </MenuFlyout>
        </u:IconButton.Flyout>
      </u:IconButton>
    </u:Breadcrumb>
    <u:IconButton
    Classes="title-bar-btn"
    Click="MinimizeButton_Click"
    Icon="mdi-window-minimize"
    Margin="0 0 6 0"
    />
    <u:IconButton
    Classes="title-bar-btn close"
    Click="CloseButton_Click"
    Icon="mdi-close"
    Margin="0 0 8 0"
    />
  </StackPanel>
</Grid>
<Grid Margin="12" Background="{DynamicResource ContentBackgroundBrush}">
  <views:MainView />
</Grid>
</DockPanel>
</Window>
